OBJECTS = init.o
RUST_LIBRARY = rust/target/release/libzigr_savvy.a
PKG_LIBS = $(RUST_LIBRARY) -lpthread -ldl -lm

$(SHLIB): $(RUST_LIBRARY)

$(RUST_LIBRARY): rust/Cargo.toml rust/Cargo.lock rust/src/lib.rs
	R_INCLUDE_DIR="$$(Rscript -e 'cat(R.home("include"))')" \
		cargo build --release --offline --manifest-path rust/Cargo.toml

clean:
	rm -f $(OBJECTS) $(SHLIB)

